# ========================================================
# CLOUDINARY CONFIGURATION
# ========================================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER_ROOT=enghub
CLOUDINARY_FOLDER_ENV=production

# ========================================================
# FILE UPLOAD LIMITS
# ========================================================
MAX_FILE_SIZE=200MB
MAX_REQUEST_SIZE=200MB
MAX_SWALLOW_SIZE=200MB

# ========================================================
# AUTH & SECURITY
# ========================================================
JWT_SIGNER_KEY=

# Allowed CORS Origins (comma-separated, NO wildcard * when credentials=true)
# Ví dụ: https://enghub.vercel.app,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# ========================================================
# GEMINI AI
# ========================================================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_ENABLED=true
GEMINI_DELETE_FILE_AFTER_USE=true

# ========================================================
# DATABASE (SUPABASE / POSTGRESQL)
# ========================================================
# Lưu ý: Bắt buộc dùng cổng 5432 (Session mode hoặc Direct) cho Flyway. KHÔNG dùng cổng 6543 (Transaction mode).
# URL bắt buộc bắt đầu bằng jdbc:postgresql:// và kèm ?sslmode=require
SPRING_DATASOURCE_URL=jdbc:postgresql://<HOST_SUPABASE>:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=
